# Gateway to run the market against.
GATEWAY_URL=http://127.0.0.1:8080
# Agents: buyer-1..N.swarm.<parent> and seller-1..M.swarm.<parent>; keys from ~/.near-credentials/testnet/ (scripts/near-swarm-setup.sh).
SWARM_PARENT=swarm.ramx.testnet
BUYERS=20
SELLERS=5
ROUNDS=10
# LLM decisions: with a key, each agent asks this OpenAI-compatible model for its bid every round
# (default NEAR AI Cloud). Without one, or if a call fails, the agent bids at random within its limits.
SWARM_LLM_API_KEY=
SWARM_LLM_BASE_URL=https://cloud-api.near.ai/v1
SWARM_LLM_MODEL=Qwen/Qwen3.8-27B
