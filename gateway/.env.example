# gateway/.env (HANDOFF §8). Required to start: POOL_COORDINATOR_URL, DATABASE_PATH, GATEWAY_SIGNING_KEY.
# World login needs JWT_SECRET + WORLD_*; x402 needs X402_PAY_TO + X402_RELAYER_*; the NEAR ledger needs NEAR_GATEWAY_* + LEDGER_CONTRACT_ID.
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=http://10.73.185.71:8080
POOL_COORDINATOR_URL=http://127.0.0.1:3001
DATABASE_PATH=./data/gateway.sqlite
# Dev phase: a database from another schema version is moved aside (gateway.sqlite-bak-vN-<time>) and recreated. false = refuse to start.
DB_RESET_ON_MISMATCH=true
# Frontend origins (Vite dev = 5173). Add the requester laptop's URL, comma-separated.
CORS_ORIGINS=http://localhost:5173
# Non-streaming only; streaming uses shared config resilience.first_token_* (post-MVP P5.1).
POOL_TIMEOUT_MS=600000
# Must match node-agent HEARTBEAT_SECONDS (uptime sampling interval).
HEARTBEAT_SECONDS=10

# World login, credit ledger and event signing
JWT_SECRET=
GATEWAY_SIGNING_KEY=
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=ramx-account
WORLD_ENVIRONMENT=staging
# TEMPORARY: staging simulator gives one nullifier to everyone; true = one account per browser (staging only).
WORLD_SIMULATOR_DEVICE_ACCOUNTS=false
STARTER_CREDITS=10000
STARTER_EXPIRY_DAYS=14
# Max new accounts per 24 h that get starter credits (empty = no cap).
STARTER_DAILY_GRANTS=200

# NEAR (testnet). The gateway's own account writes the ledger contract (and the registry, Phase 4).
NEAR_GATEWAY_ACCOUNT_ID=gateway.ramx.testnet
NEAR_GATEWAY_KEY=
# contracts-near/ledger, initialised with writer = NEAR_GATEWAY_ACCOUNT_ID and pubkey = `node src/verify-event.ts --pubkey`.
LEDGER_CONTRACT_ID=ledger-v2.ramx.testnet

# x402 on NEAR (USDC NEP-141, network/asset in shared config x402_near). Requests without a session pay per request.
# Treasury that receives USDC (run storage_deposit on the USDC contract for it first).
X402_PAY_TO=treasury.ramx.testnet
# In-process facilitator: relayer account that submits payers' signed delegates and pays gas (holds NEAR only).
X402_RELAYER_ID=relayer.ramx.testnet
X402_RELAYER_KEY=
# Alternative to the relayer: a remote NEAR x402 facilitator URL (used only when X402_RELAYER_* is empty).
X402_FACILITATOR_URL=
# NEAR JSON-RPC (default: FastNEAR testnet; rpc.testnet.near.org is deprecated and rate-limited).
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Guarded agents pay the treasury through this escrow contract (POST /v1/credits/escrow).
ESCROW_CONTRACT_ID=escrow.ramx.testnet
# Epoch payouts (contracts-near/payout). Setting PAYOUT_CONTRACT_ID turns settlement on (needs the ledger writer too).
# The settler is the treasury (X402_PAY_TO): it posts each epoch with one USDC ft_transfer_call and needs NEAR for gas.
PAYOUT_CONTRACT_ID=payout.ramx.testnet
SETTLER_ACCOUNT_ID=treasury.ramx.testnet
SETTLER_KEY=
EPOCH_SECONDS=600

# Optional live verification CLI only; never required by the gateway server.
# A session token for an idle requester account. --inference explicitly spends its credits.
VERIFY_SESSION_TOKEN=

# Post-MVP P5 (docs/POST_MVP_PLAN.md). Absolute paths on the scheduler host; empty = off.
# Allow-list the scheduler hook reads (pool/scheduler.env ALLOWED_PEERS_FILE must be the same file).
PARALLAX_ALLOWED_PEERS_FILE=
# Hook route log (<repo>/pool/run/routes.jsonl). Set ONLY when the scheduler runs with pool/hooks.
PARALLAX_ROUTE_LOG=
# Tool calling for OpenAI clients (OpenCode): emulate = tools in the prompt, <tool_call> parsed back; native = pass through
TOOLS_MODE=emulate

# SPEC §16.2 output verification: both reference services must be trusted and independently calibrated.
# Output verification (SPEC §16.2) is a planned feature and is OFF. Keep false; the keys below are unused while off.
VERIFICATION_ENABLED=false
# Leave VERIFIER_URL empty until a reference implementation has a valid model and calibration set.
VERIFIER_URL=
VERIFIER_OWNER_ACCOUNT=
VERIFIER_SECONDARY_URL=
VERIFIER_SECONDARY_OWNER_ACCOUNT=
VERIFICATION_MAX_RATE=0.2
VERIFICATION_MIN_RATE=0.005
VERIFICATION_COST_MC=1
VERIFICATION_APPEAL_HOURS=24
# SPEC §16.1 many pools: {"pool-id":"http://127.0.0.1:3102"} and/or the file pool/pools-up.sh writes.
POOL_COORDINATORS=
POOL_COORDINATORS_FILE=
# SPEC §16.1 privacy: acc_ IDs trusted with the first and last layers (x-ramx-privacy: trusted-ends)
# SPEC §16.3 private pools: {"pool-id":["acc_…"]}
PRIVATE_POOLS=
TRUSTED_ACCOUNTS=
# Privacy (SPEC §5.6): transcript encryption key (openssl rand -hex 32) and HTTPS certificate files.
TRANSCRIPT_KEY=
# #6: "false" turns off swapping emails, phone numbers, card numbers and secrets for placeholders before prompts reach laptop pools (default on)
PII_REDACTION=
TLS_CERT_FILE=
TLS_KEY_FILE=

# NEAR AI Cloud API key (TEE spot-check judge; needs inference credits on cloud.near.ai). Never commit the value.
NEARAI_API_KEY=
# Share of answers spot-checked (0-1); privacy requests are never sampled. Judge model (a TEE model on NEAR AI Cloud).
TEE_JUDGE_RATE=0.1
TEE_JUDGE_MODEL=Qwen/Qwen3.8-27B
# Judge mode: when no laptop pool is ready (or on x-ramx-privacy: tee), serve from NEAR AI Cloud.
NEARAI_FALLBACK=true
# Optional: JSON map from our model ids to NEAR AI model names; unlisted models use TEE_JUDGE_MODEL.
NEARAI_MODEL_MAP=
