# Public browser configuration only (never put a key here). All application data is live.
VITE_GATEWAY_URL=http://localhost:8080
VITE_WORLD_APP_ID=
VITE_WORLD_ACTION=ramx-account
# NEAR testnet JSON-RPC for read-only checks (ledger sequence).
VITE_NEAR_RPC=https://rpc.testnet.fastnear.com
# NEAR contracts, shown as explorer links.
VITE_LEDGER_CONTRACT=ledger-v2.ramx.testnet
VITE_PAYOUT_CONTRACT=payout.ramx.testnet
# USDC top-ups go to this treasury.
VITE_TREASURY=treasury.ramx.testnet
