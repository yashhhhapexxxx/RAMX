import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { meFromWire,receiptFromWire,ledgerFromWire,rpFromWire,payoutsFromWire,networkFromWire,keysFromWire,newKeyFromWire,keyRequestsFromWire } from '../src/data/live/adapters.ts';
const fixture=(name:string)=>JSON.parse(readFileSync(new URL(`../../shared/examples/${name}.json`,import.meta.url),'utf8'));
const me=fixture('me-response');
assert.equal(meFromWire(me).balance.starter,me.balance.starter_mc/1000);
assert.deepEqual(meFromWire(me).incentives,me.incentives);
const r=fixture('receipt');assert.equal(receiptFromWire(r).cost,(r.cost_mc??0)/1000);
assert.equal(receiptFromWire(r).x402_amount,r.x402_amount);
assert.equal(ledgerFromWire(fixture('ledger-events-response'))[0].type,fixture('ledger-events-response').events[0].event.type);
assert.equal(rpFromWire(fixture('rp-signature-response')).signature,fixture('rp-signature-response').sig);
assert.equal(networkFromWire(fixture('network-response')).nodes.length,fixture('network-response').nodes.length);
const netv=networkFromWire(fixture('network-response'));
assert.equal(netv.pools[0].restarting,false);assert.equal(netv.pools[0].route_dispute,false);
assert.ok(netv.pools[0].members.length>netv.nodes.length,'pool members without a node listing are kept');
assert.equal(receiptFromWire(r).account_id,r.account_id);
assert.deepEqual(payoutsFromWire(fixture('payouts-response')).epochs,[]);
assert.throws(()=>meFromWire({balance:{starter:10000}}));
const kl=fixture('agent-key-list-response');assert.equal(keysFromWire(kl)[0].spent,kl.agents[0].spent_mc/1000);assert.equal(keysFromWire(kl)[0].cap,kl.agents[0].budget_mc/1000);
assert.equal(keysFromWire(kl)[0].bought,kl.agents[0].key_credits_mc/1000);assert.equal(keysFromWire(kl)[0].boughtTotal,kl.agents[0].bought_total_mc/1000);
const kc=fixture('agent-key-create-response');assert.equal(newKeyFromWire(kc).cap,null);assert.equal(newKeyFromWire(kc).token,kc.token);
const kr=fixture('agent-requests-response');assert.equal(keyRequestsFromWire(kr)[0].cost,kr.requests[0].cost_mc/1000);assert.equal(keyRequestsFromWire(kr)[1].cost,null);
assert.throws(()=>keysFromWire({agents:[{agent_id:'bad'}]}));
const {api}=await import('../src/data/index.ts');
const original=globalThis.fetch;
globalThis.fetch=async()=>{throw new TypeError('offline')};
await assert.rejects(api.network(),/offline/);
await assert.rejects(api.models(),/offline/);
const mr=fixture('models-response');mr.data[0].context_length=8192;mr.data[0].price={credits_per_1k_in:350,credits_per_1k_out:1750,multiplier:1,quoted_at:1};
globalThis.fetch=async()=>Response.json(mr);
const offers=await api.models();assert.equal(offers[0].context_length,8192);assert.equal(offers[0].price?.multiplier,1);
delete mr.data[0].context_length;delete mr.data[0].price;assert.equal((await api.models())[0].context_length,undefined,'unknown context stays unknown: the page falls back to config');
globalThis.fetch=async()=>new Response('data: {"choices":[{"delta":{"content":"partial"}}]}\n\n',{status:200});
await assert.rejects(async()=>{for await(const _ of api.chat({model:'test',messages:[{role:'user',content:'hello'}],max_tokens:4},null,new AbortController().signal)){}},/without a completion marker/);
globalThis.fetch=original;
console.log('Live adapters, validation, outage and truncated stream checks passed');
