# Copy to pool/node.env (ROLE=node) on each node. On the coordinator ALSO copy to
# pool/scheduler.env with ROLE=scheduler, TCP_PORT/UDP_PORT=5100 (the coordinator runs both).
# Ports: scheduler 5100, Linux node 5101, Mac nodes 5102, 5103 (TCP+UDP).
PARALLAX_DIR=$HOME/parallax
ROLE=node                 # scheduler | node
MODEL=Qwen/Qwen3-14B-FP8  # scheduler only (nodes get their layers from the scheduler)
INIT_NODES=3              # scheduler only
DHT_PREFIX=ramx-x7k2
LAN_IP=
TCP_PORT=5101
UDP_PORT=5101
HF_HOME=                  # model cache; Mac 14B MLX: <parallax>/.cache/huggingface
EXTRA_FLAGS=              # Mac: "--kv-cache-memory-fraction 0.25 --max-sequence-length 4096" (quote it)
CUDA_HOME=                # CUDA nodes: $PARALLAX_DIR/.venv/lib/python3.12/site-packages/nvidia/cu13
# Post-MVP P5 (docs/POST_MVP_PLAN.md)
HOOKS=1                   # 1 = load pool/hooks (grace, ghost guard, route log, peer id file); 0 = plain Parallax
NOTIFY_PORT=5190          # node agent listens on 127.0.0.1:NOTIFY_PORT for --notify-url events (P5.9); empty = off
ALLOWED_PEERS_FILE=       # scheduler only: absolute path of the gateway's allow-list (P5.4), e.g. <repo>/pool/run/allowed-peers.json; empty = off
ALLOW_MAC_DEFAULT_MEMORY=0 # 1 = let a Mac start without the memory flags (not recommended)
# SPEC §16.1 (all empty = MVP)
API_PORT=                 # scheduler only: private API port (default 3001)
PROCESS_NAME=             # scheduler only: process name (default scheduler)
REBALANCE_COOLDOWN_S=     # scheduler only: wait before reloading all nodes after a leave (default 60)
SCHEDULER_ADDR=           # WAN: scheduler multiaddr /ip4/<ip>/tcp/<port>/p2p/<peer>
RELAY_SERVERS=            # WAN: our own relay multiaddrs (space-separated)
INITIAL_PEERS=            # WAN: bootstrap multiaddrs (space-separated)
START_LAYER=              # privacy: pin this node to [START_LAYER, END_LAYER)
END_LAYER=
MAX_BATCH_SIZE=           # batching: Parallax --max-batch-size
MICRO_BATCH_RATIO=        # batching: Parallax --micro-batch-ratio (micro batch = MAX_BATCH_SIZE / ratio; managed pools use 2)
SCHEDULER_WAIT_MS=        # batching: Parallax --scheduler-wait-ms (default 500; managed pools use 50)
ALLOW_DEBUG_LOGS=0         # privacy: 1 allows --verbose / --log-level debug (Parallax then logs prompts)
