# Gateway to call (your deployed RAMX gateway or http://127.0.0.1:8080).
GATEWAY_URL=http://127.0.0.1:8080
# NEAR testnet account that pays x402 in USDC (must hold testnet USDC; see docs/IMPLEMENTATION.md Phase 0).
AGENT_ACCOUNT_ID=agent-1.ramx.testnet
# Its full-access key, ed25519:<base58> (from ~/.near-credentials/testnet/<account>.json). Never commit.
AGENT_SECRET_KEY=
# Stop before spending more than this (USDC).
AGENT_BUDGET_USDC=0.05
# Optional NEAR RPC override.
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# pnpm topup: your RAMX API key (gpa_…) to buy credits for; 1 USDC = 1000 credits.
RAMX_API_KEY=
# Guarded agent (pnpm guarded / pnpm attack): only a function-call key on escrow.pay. Written by scripts/near-setup.sh.
ESCROW_CONTRACT_ID=escrow.ramx.testnet
GUARDED_AGENT_ID=agent-2.ramx.testnet
# Its FUNCTION-CALL key (ed25519:…): can call escrow.pay only, no deposits. Never commit.
GUARDED_AGENT_FC_KEY=
# The guarded agent's RAMX API key (gpa_…); escrow payments are credited to it.
GUARDED_API_KEY=
TREASURY_ACCOUNT_ID=treasury.ramx.testnet

# Privacy self-check (src/private.ts): ledger contract the gateway writes to, and (optional) your own
# NEAR AI Cloud key so the script fetches the TEE model's attestation itself with its own nonce.
LEDGER_CONTRACT_ID=ledger-v3.ramx.testnet
NEARAI_API_KEY=
